# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Multimodal Meta LLaMA API Configuration
# Compatible with Groq, Together AI, OpenRouter, or any OpenAI-compatible provider serving LLaMA
LLAMA_API_KEY=
LLAMA_API_BASE_URL=https://api.groq.com/openai/v1
LLAMA_VISION_MODEL=llama-3.2-11b-vision-preview
LLAMA_TEXT_MODEL=llama-3.3-70b-versatile

# Weather API Configuration
# Options: "open-meteo" (Default, Real live forecasts worldwide with NO API key needed), or "openweathermap"
WEATHER_API_PROVIDER=open-meteo
OPENWEATHERMAP_API_KEY=

# Image Generation Configuration (Flux / Pollinations for architectural 3D visualizations)
ENABLE_IMAGE_GENERATION=true
